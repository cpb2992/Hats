{
  "expo": {
    "name": "Hats",
    "slug": "hats-focus",
    "scheme": "hats",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF4E3",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hatsfocus.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hatsfocus.app",
      "adaptiveIcon": {
        "backgroundColor": "#F3F1EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2,
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": {
            "mimeType": "text/plain"
          }
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FFF4E3",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#FFF4E3"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3D65A2"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hats listens when you tap Say anything, so you can capture tasks out loud.",
          "speechRecognitionPermission": "Hats turns what you say into tasks.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/BricolageGrotesque-SemiBold.ttf",
            "./assets/fonts/InterTight-Medium.ttf",
            "./assets/fonts/InterTight-SemiBold.ttf",
            "./assets/fonts/InterTight-Bold.ttf"
          ],
          "widgets": [
            {
              "name": "HatsNow",
              "label": "Hats \u00b7 Now",
              "description": "Your personal home life, with a useful next step.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/now.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "HatsLog",
              "label": "Hats \u00b7 Home life",
              "description": "Your personal home life, with a useful next step.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/log.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "HatsSay",
              "label": "Hats \u00b7 Say anything",
              "description": "Your personal home life, with a useful next step.",
              "minWidth": "110dp",
              "minHeight": "50dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/say.png"
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000000",
      "requestHeaders": {
        "expo-channel-name": "personal"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "enabled": false
    }
  }
}
